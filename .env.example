# -- Azure Speech Service ----------------------------------------
# Create a Speech resource in one of the supported regions:
#   - westeurope (recommended for EU)
#   - westus2
#   - southeastasia
# IMPORTANT: Use Standard S0 pricing tier to access avatars
# Leave AZURE_SPEECH_KEY empty to use Managed Identity (recommended).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Custom endpoint (required for Managed Identity with custom domain)
# AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com

# -- Azure Storage (for persistent video storage) ---------------
# Option 1 (recommended): Leave CONNECTION_STRING empty to use Managed Identity.
#   Requires AZURE_STORAGE_ACCOUNT_NAME and the identity must have:
#   - Storage Blob Data Contributor (upload/download blobs)
#   - Storage Blob Delegator (generate user delegation SAS keys)
# Option 2: Use a connection string (shared key - not recommended).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER=podcast-videos
AZURE_STORAGE_BACKGROUNDS_CONTAINER=podcast-backgrounds

# -- Azure OpenAI (optional - for topic-to-script generation) ---
# Only ENDPOINT is required. Auth uses Managed Identity (Entra ID).
# Leave AZURE_OPENAI_KEY empty to use Managed Identity (recommended).
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -- Managed Identity (for Entra ID auth) -----------------------
# Set this to the User-Assigned Managed Identity client ID.
# In Azure Container Apps, this is set automatically by Bicep.
# For local dev, leave empty to use DefaultAzureCredential (az login).
AZURE_CLIENT_ID=

# -- Avatar Defaults --------------------------------------------
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting
TTS_VOICE=it-IT-DiegoNeural
TTS_LANGUAGE=it-IT

# -- API Key Authentication (optional) --------------------------
# Set to enable X-API-Key header authentication
API_KEY=

# -- SAS URL expiry (hours) -------------------------------------
SAS_EXPIRY_HOURS=48

# -- Rate Limiting -----------------------------------------------
# Set to 0 to disable
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
